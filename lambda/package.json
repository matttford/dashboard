{
  "name": "dashboard-lambda",
  "version": "0.0.1",
  "type": "module",
  "description": "Dashboard Lambda function",
  "main": "dist/index.js",
  "scripts": {
    "clean": "rm -rf ./dist",
    "compile": "tsc",
    "postbuild": "cp package.json ./dist/package.json && npm run zip",
    "build": "npm run clean && npm run compile",
    "zip": "cd dist && zip -r ../source.zip ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.820.0",
    "@aws-sdk/s3-request-presigner": "^3.820.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^22.4.0",
    "typescript": "^5.8.3"
  }
}